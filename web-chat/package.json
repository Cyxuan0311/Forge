{
  "name": "forge-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone ChatGPT-style chat UI for forge-server. Built by CMake, embedded into the binaries by cmake/EmbedDashboardAssets.cmake.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:markdown": "node scripts/test-markdown.mjs",
    "test:store": "node scripts/test-store-actions.mjs",
    "test": "node scripts/test-markdown.mjs && node scripts/test-store-actions.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.6.3",
    "vite": "^7.1.5",
    "vue-tsc": "^2.1.10"
  }
}
